# Copy to .env (with the leading dot) and edit. The compose file uses
# ${VAR:-default} substitution so the stack runs with defaults if .env
# is missing entirely. To source this template at runtime instead of
# creating .env, run:
#   docker compose --env-file env.example up
#
# Passwords (POSTGRES_PASSWORD, PG_*_PASSWORD) have NO defaults. They
# must be set in .env or the postgres container refuses to start. Pick
# strong, distinct values per role; rotate by editing .env and running
# `docker compose up -d` (the bootstrap re-applies them on a fresh volume).

# -------- Build-time (version stamping) -------------------------------
# Both Dockerfiles stamp the binary with -X main.version=$VERSION-$GIT_HEAD.
# Override at build time:
#   GIT_HEAD=$(git rev-parse --short HEAD) docker compose build

VERSION=0.1.0-dev
# GIT_HEAD=unknown       # uncomment to pin; otherwise build with the env var above

# -------- messaging-core ----------------------------------------------
# Bind address. Defaults to "messaging-core", the docker service name.
# With network_mode: host that hostname does not resolve via Docker
# DNS, so the compose file injects an /etc/hosts entry mapping
# "messaging-core -> 127.0.0.1" on every service. The embedded NATS
# server then binds to the host loopback.
#
# Set to 0.0.0.0 if a remote client on another host needs to connect
# (and add NATS auth/TLS — tracked as a follow-up).
NATS_HOST=messaging-core
NATS_PORT=4222

# Reserved for a future JetStream store path. Empty = disabled.
# NATS_DATA_DIR=

# WebSocket / HTTP port for the camera streaming gateway.
# Web clients connect to ws://pi:8080/stream/{mac}.
STREAM_PORT=8080

# Postgres connection for messaging-core. Use MESSAGING_CORE_PG_* vars
# (not generic PG_*) to avoid colliding with the workers service.
# MESSAGING_CORE_PG_PASSWORD falls back to PG_MESSAGING_CORE_PASSWORD
# if not set, so existing .env files continue to work.
MESSAGING_CORE_PG_HOST=127.0.0.1
MESSAGING_CORE_PG_PORT=5432
MESSAGING_CORE_PG_DATABASE=witsaba
MESSAGING_CORE_PG_USER=pg-messaging-core
MESSAGING_CORE_PG_PASSWORD=change-me-messaging-core

# -------- workers -----------------------------------------------------

# How often the discovery job fires. > 0. Default 60.
DISCOVERY_INTERVAL_SECONDS=60

# Per-IP GET /whoami timeout in milliseconds. > 0. Default 1500.
DISCOVERY_PROBE_TIMEOUT_MS=1500

# Max concurrent probe goroutines per scan. > 0. Default 64.
DISCOVERY_WORKER_POOL_SIZE=64

# -------- Postgres ----------------------------------------------------
# Shared witsaba database. Required by both messaging-core and workers.
# Roles and grants are created by services/postgres/init/* on first
# boot of an empty data volume. See services/postgres/README.md.

# Database name. Default witsaba.
POSTGRES_DB=witsaba

# Admin role. NOT the postgres superuser; this is a CREATEDB/CREATEROLE
# role created by the postgres entrypoint using POSTGRES_PASSWORD. Owns
# the witsaba schema. Use this role for migrations.
POSTGRES_USER=pg-admin

# Admin password. Must be set. Re-applied to the role on every init.
POSTGRES_PASSWORD=change-me-admin

# TCP port Postgres listens on. Default 5432. Binds to 127.0.0.1 only
# (enforced by listen_addresses in docker-compose.yml), so 5432 is NOT
# reachable from the LAN under network_mode: host.
POSTGRES_PORT=5432

# Password for the pg-worker role. Used by services/workers to connect
# with INSERT/UPDATE/SELECT on witsaba.devices. Must be set.
PG_WORKER_PASSWORD=change-me-worker

# Password for the pg-messaging-core role. Used by services/messaging-core
# to connect with SELECT on witsaba.devices. Must be set.
PG_MESSAGING_CORE_PASSWORD=change-me-messaging-core

# -------- shared ------------------------------------------------------

# debug | info | warn | error (case-insensitive). Default info.
LOG_LEVEL=info