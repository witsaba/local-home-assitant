# sdkconfig.defaults — embedded/iot_cams firmware defaults.
#
# Read by `idf.py reconfigure` on every fresh build. Each
# CONFIG_* here is the project floor; a developer can override
# per-machine via `idf.py menuconfig` (writes to gitignored
# `./sdkconfig`) or per CI run via `sdkconfig.ci`.
#
# Adding a value here without matching the same default in
# `components/provisioning/Kconfig.projbuild` is a bug — Kconfig
# will resolve the conflict in favor of the user's local config
# and the build will start ignoring one or the other.

# === Bootloader / flasher ===
#
# AI-Thinker ESP32-CAM comes populated with a 4 MB SPI flash
# (the partition label 'W25Q32'). Without the explicit 4 MB
# override, the bootloader rejects 4 KB of address space at
# the top of the chip and the boot log warns
# 'Detected size(4096k) larger than the size in the binary
# image header(2048k)'. Crystal is 40 MHz on every board
# revision we ship; DIO mode matches the AI-Thinker reference
# schematic.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# === WiFi provisioning ===
#
# Mirrors `components/provisioning/Kconfig.projbuild`. With
# these set, a fresh checkout + flash puts the device into a
# softAP at `IoT-Cam_3091B0` (WPA2 passphrase / PoP from
# `abcd1234`), bypassing a menuconfig session. The phone-app
# operator must still type the passphrase + PoP on first
# join.
#
# Both `abcd1234` defaults are PLACEHOLDERS. Ship-time
# packaging must replace them with per-fleet values (per
# batch or per device) so a single batch of provisioning
# credentials can't cycle onto a second batch of devices.
CONFIG_PROVISIONING_POP="abcd1234"
CONFIG_PROVISIONING_SOFTAP_PASS="abcd1234"
CONFIG_PROVISIONING_SERVICE_NAME_PREFIX="IoT-Cam"
CONFIG_PROVISIONING_DEVICE_NAME="iot-cam"

# === Protocomm security model ===
#
# Security 1 (X25519 + PoP + AES-CTR) is the production target
# and is the value the `provisioning_config_t::security`
# default of PROV_SECURITY_1 maps to. We pin it here so a
# menuconfig fiddler can't accidentally leave the firmware
# with no security versions compiled in (the IDF default
# enables all three, but the choice isn't enforced).
#
# Security 0 (plaintext, debug-only) and Security 2 (SRP6a,
# needs a sibling component to wire up) are intentionally
# not addressed here — both default OFF once V1 is the only
# "select" target.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# === Default partition table ===
#
# The IDF v5.5 default partition table (single 1 MB 'factory'
# app + 24 KB NVS + 4 KB PHY) is correct for this firmware
# at -O3 — see `idf.py build` output
# `iot_cams.bin binary size 0xdf220 bytes ... 0x20de0 bytes
# (13%) free`. Leave the partition table at IDF defaults
# until camera + ws components push past the 13% ceiling;
# at that point switch to `partitions.csv` with a 1.5 MB
# factory partition (matches `esp32-cam-surveillance`'s
# firmware/sdkconfig.defaults convention).
